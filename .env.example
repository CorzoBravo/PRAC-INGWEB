# ==========================================
# Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y asigna tus valores
# ==========================================

# Base de datos PostgreSQL
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=clinica_db

# Clave secreta para firma y verificación de JWT
JWT_SECRET=tu_jwt_secret_seguro_aqui

# Entorno de ejecución (development | production)
NODE_ENV=production

# URL del API Gateway consumida por el Frontend
VITE_API_URL=http://localhost:3000/api
